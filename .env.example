# Sample environment variables for local development
# Copy to .env for local testing (NEVER commit your actual .env file)

MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=flask_db

# MongoDB root credentials (used during local Docker container startup)
MONGO_INITDB_ROOT_USERNAME=admin_root
MONGO_INITDB_ROOT_PASSWORD=replace_with_strong_root_password

# MongoDB application-specific credentials (used by Flask)
MONGO_APP_USERNAME=flask_app
MONGO_APP_PASSWORD=replace_with_strong_app_password

# Alternative single connection string (optional)
# MONGODB_URI=mongodb://flask_app:password@localhost:27017/flask_db?authSource=flask_db

